    { "source": "/brand/:path*", "destination": "https://mirra-brand-portal.vercel.app/brand/:path*" },
    { "source": "/brand-static/:path*", "destination": "https://mirra-brand-portal.vercel.app/brand-static/:path*" }
  ]
}
